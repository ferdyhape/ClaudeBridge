PORT=4577

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=claudebridge

# Accounts idle longer than this get logged out and cleaned up automatically.
SESSION_MAX_IDLE_DAYS=30

# Set to "false" to hide the "Built by ferdyhape.com" footer — e.g. once
# a deployment is registered as an internal company tool.
SHOW_BRAND_FOOTER=true

# MCP servers this deployment is willing to expose to POST /ask, as JSON:
#   {"<name>": {"command": "...", "args": ["..."], "runIdFlag": "--run-id"}}
#
# Empty/unset (the default) keeps /ask text-only, exactly as before.
#
# A request may only NAME a server listed here — it can never send its own
# command. That distinction is the whole security boundary: an MCP server
# definition spawns a process, so accepting one from a caller would hand
# every API key holder arbitrary code execution on this host.
#
# `runIdFlag` is optional and per-server: the flag that server accepts to
# correlate one /ask call with whatever it records on its own side.
#
# Example (kagami's checker tools, same host):
# MCP_SERVERS_JSON={"kagami":{"command":"php","args":["/home/you/git-project/funky-ai/kagami/engine/review/mcp.php"],"runIdFlag":"--run-id"}}
